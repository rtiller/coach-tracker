{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coach-tracker/plan.schema.json",
  "title": "Workout tracker plan, schema 1",
  "description": "Cross-field rules (one anchor per training day, blocks 1..ceil(weeks/blockWeeks), every block lists every training day key, unique day keys) are checked by the tracker and tools/encode-plan.js. See PLAN-SCHEMA.md.",
  "type": "object",
  "required": ["meta", "days", "blocks"],
  "properties": {
    "schema": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["name", "weeks"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "weeks": { "type": "integer", "minimum": 1, "maximum": 52 },
        "blockWeeks": { "type": "integer", "minimum": 1, "maximum": 52 },
        "deload": { "oneOf": [ { "enum": ["last", "none"] }, { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 52 } } ] },
        "deloadNote": { "type": "string", "maxLength": 300 },
        "units": { "enum": ["lb", "kg"] },
        "notes": { "type": "string", "maxLength": 1500 }
      },
      "not": { "anyOf": [ { "required": ["start"] }, { "required": ["startDate"] } ] }
    },
    "days": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object",
        "properties": {
          "rest": { "type": "boolean" },
          "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
          "label": { "type": "string", "maxLength": 40 },
          "short": { "type": "string", "maxLength": 4 },
          "focus": { "type": "string", "maxLength": 80 },
          "priority": { "type": "boolean" },
          "note": { "type": "string", "maxLength": 120 }
        },
        "if": { "not": { "properties": { "rest": { "const": true } }, "required": ["rest"] } },
        "then": { "required": ["key", "label"], "properties": { "label": { "minLength": 1 } } }
      }
    },
    "blocks": {
      "type": "object",
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "additionalProperties": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["name", "sets"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "sets": { "type": "string", "maxLength": 60 },
              "tags": { "type": "array", "items": { "enum": ["anchor", "priority", "optional", "accessory"] } },
              "note": { "type": "string", "maxLength": 160 },
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" }
            }
          },
          "contains": { "type": "object", "properties": { "tags": { "contains": { "const": "anchor" } } }, "required": ["tags"] },
          "minContains": 1, "maxContains": 1
        }
      }
    },
    "lifts": {
      "type": "array", "maxItems": 20,
      "items": { "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 60 },
        { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 60 }, "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" } } }
      ] }
    },
    "labels": {
      "type": "object",
      "properties": {
        "anchor": { "type": "string", "minLength": 1, "maxLength": 20 },
        "priority": { "type": "string", "minLength": 1, "maxLength": 20 },
        "optional": { "type": "string", "minLength": 1, "maxLength": 20 },
        "accessory": { "type": "string", "minLength": 1, "maxLength": 20 },
        "hints": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 240 } }
      },
      "additionalProperties": false
    }
  }
}
